@code {
    // Le boot log du hero est animé côté C# (PeriodicTimer + StateHasChanged),
    // pas en JavaScript : c'est le même pipeline C#.NET que celui décrit sur la page.
    private static readonly string[] Lines =
    {
        "> initialisation des modules...",
        "> chargement C#.NET / .NET SDK ......... OK",
        "> connexion Azure Foundry / OpenAI ...... OK",
        "> orchestration n8n ...................... OK",
        "> moteur RAG + modèles locaux (Ollama) ... OK",
        "> agent prêt."
    };

    private string displayed = "";
    private PeriodicTimer? timer;

    protected override async Task OnInitializedAsync()
    {
        var full = string.Join("\n", Lines);
        timer = new PeriodicTimer(TimeSpan.FromMilliseconds(14));
        var i = 0;

        while (i <= full.Length && await timer.WaitForNextTickAsync())
        {
            displayed = full[..i];
            i += 2;
            StateHasChanged();
        }

        displayed = full;
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        timer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
